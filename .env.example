# Deep Agents (Chief Editor and Researcher subagents)
DEEP_AGENT_MODEL=openai:gpt-5.4
# Keep false for third-party OpenAI-compatible gateways that implement only
# /chat/completions. Set true only for a compatible /responses endpoint.
DEEP_AGENT_USE_RESPONSES_API=false
DEEP_AGENT_MAX_OUTPUT_TOKENS=2048
# One application-owned budget: initial request plus at most 5 retries.
# Provider SDK retries are disabled to avoid multiplying hidden attempts.
MODEL_MAX_RETRIES=5
MODEL_RETRY_INITIAL_DELAY_SECONDS=2
MODEL_RETRY_BACKOFF_FACTOR=2
MODEL_RETRY_MAX_DELAY_SECONDS=30
MODEL_RETRY_JITTER=true

# GPT Researcher 0.16.0
# Its provider-specific variables are passed through unchanged. These are the
# common OpenAI-compatible settings; configure the provider you actually use.
OPENAI_API_KEY=
OPENAI_BASE_URL=
FAST_LLM=openai:gpt-4.1-mini
SMART_LLM=openai:gpt-4.1
STRATEGIC_LLM=openai:gpt-4.1

# Web search provider used by GPT Researcher
RETRIEVER=duckduckgo
# Set RETRIEVER=tavily and provide this key for Tavily instead.
TAVILY_API_KEY=

# Embedded private knowledge (paths are application configuration, never Tool arguments)
PERSONAL_KNOWLEDGE_ROOT=personal_knowledge_data
PERSONAL_KNOWLEDGE_CORPUS_DIR=data/3gpp
PERSONAL_KNOWLEDGE_INDEX_DIR=.local/indexes/specifications
PERSONAL_KNOWLEDGE_RELEASE=17
PERSONAL_KNOWLEDGE_MAX_RESULTS=6
PERSONAL_KNOWLEDGE_ALLOW_INDEX_BUILD=false
# Retain the SpecRAG-derived Planner -> Researchers -> Merger -> local brief.
PERSONAL_KNOWLEDGE_RESEARCH_ENABLED=true
# Privacy gate: full local research sends selected evidence excerpts to the
# configured Planner/Researcher/Synthesizer model. Keep false until authorized.
PERSONAL_KNOWLEDGE_ALLOW_EXTERNAL_MODEL=false
# Empty means reuse DEEP_AGENT_MODEL.
PERSONAL_KNOWLEDGE_RESEARCH_MODEL=
PERSONAL_KNOWLEDGE_MODEL_MAX_OUTPUT_TOKENS=4096
PERSONAL_KNOWLEDGE_MAX_TASKS=3
PERSONAL_KNOWLEDGE_MAX_RETRIEVAL_ROUNDS=4
PERSONAL_KNOWLEDGE_MAX_PARALLEL_TASKS=3
PERSONAL_KNOWLEDGE_MAX_TOOL_CALLS_PER_TASK=12

# Research runtime
OUTPUTS_DIR=outputs
MAX_PARALLEL_RESEARCHERS=3
MAX_REVISION_ROUNDS=1
MAX_SEARCH_RESULTS=5
RESEARCH_TOOL_TIMEOUT_SECONDS=900

