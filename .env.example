# Deep Agents (Chief Editor and Researcher subagents)
DEEP_AGENT_MODEL=openai:gpt-5.4

# GPT Researcher 0.16.0
# Its provider-specific variables are passed through unchanged. These are the
# common OpenAI-compatible settings; configure the provider you actually use.
OPENAI_API_KEY=
OPENAI_BASE_URL=
FAST_LLM=openai:gpt-4.1-mini
SMART_LLM=openai:gpt-4.1
STRATEGIC_LLM=openai:gpt-4.1

# Web search provider used by GPT Researcher
RETRIEVER=duckduckgo
# Set RETRIEVER=tavily and provide this key for Tavily instead.
TAVILY_API_KEY=

# SpecRAG service (never exposed as agent tool arguments)
SPECRAG_BASE_URL=http://127.0.0.1:8000
SPECRAG_WORKSPACE_ID=
SPECRAG_ACCESS_TOKEN=

# Research runtime
OUTPUTS_DIR=outputs
MAX_PARALLEL_RESEARCHERS=3
MAX_REVISION_ROUNDS=1
MAX_SEARCH_RESULTS=5
RESEARCH_TOOL_TIMEOUT_SECONDS=900

# SpecRAG tool
SPECRAG_RELEASE=17
SPECRAG_ANSWER_LANGUAGE=Chinese
SPECRAG_DETAIL_LEVEL=standard
SPECRAG_POLL_INTERVAL_SECONDS=2
SPECRAG_POLL_TIMEOUT_SECONDS=60
SPECRAG_HTTP_TIMEOUT_SECONDS=30

